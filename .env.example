# Every environment variable this application reads, with the default it falls
# back to. Nothing here is required -- the defaults are what the README
# documents, and an unset variable is not an error.
#
# Nothing auto-loads this file. backend/app/config.py reads process environment
# variables only, so either export what you need, or hand the file to uvicorn:
#
#   cd backend && python3 -m uvicorn app.main:app --port 8000 --env-file ../.env
#
# (--env-file needs python-dotenv, which ships with the uvicorn[standard] extra
# already in backend/requirements.txt.)
#
# The batch CLIs -- python3 -m app.ingest / app.analyze / app.enrich --
# do NOT read it. Export the variables in the shell that runs
# them, and use the same provider/model selector you intend to serve with
# (`CVDE_EMBED_MODEL` for SigLIP or `CVDE_QWEN_EMBED_MODEL` for Qwen).

# --- Storage -----------------------------------------------------------------
# Images, thumbnails, explorer.db, embeddings, caches, QA artifacts and
# generated reports all live under here. Gitignored; nothing in it is a
# deliverable. Relative paths resolve from the process working directory; the
# documented commands run from backend/, so "data" means backend/data.
CVDE_DATA_DIR=data

# --- Retrieval provider ------------------------------------------------------
# siglip2 (default — measures better on this corpus's own benchmark) or
# qwen3_vl (opt-in; needs requirements-qwen.txt and its own ingest run).
# Each provider owns its index directory and schema-v2 commit marker. It binds
# the exact cached model revision and preprocessing fingerprint to the array
# dimensions, counts and ordered IDs; Qwen also binds its prompt version.
# A legacy, incomplete or mismatched index refuses to serve rather than ranking
# in the wrong vector space.
CVDE_EMBED_PROVIDER=siglip2
CVDE_QWEN_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
CVDE_QWEN_EMBED_BATCH=8

# --- Embedding model (SigLIP) ------------------------------------------------
# Changing this invalidates the existing SigLIP marker. Rebuild from backend/
# with `python3 -m app.ingest --provider siglip2`; until then semantic retrieval
# degrades with that guidance instead of mixing query and corpus vector spaces.
CVDE_EMBED_MODEL=google/siglip2-base-patch16-256
CVDE_EMBED_BATCH=32

# --- Optional local region models -------------------------------------------
# Both request paths are cache-only. Download the chosen revision explicitly
# before using the feature; changing either selector never starts a request-time
# model download.
CVDE_DETECT_MODEL=IDEA-Research/grounding-dino-tiny
CVDE_DETECT_REVISION=a2bb814dd30d776dcf7e30523b00659f4f141c71
CVDE_SEGMENT_MODEL=facebook/sam2.1-hiera-tiny
CVDE_SEGMENT_REVISION=de431c4043854a71d8101e17995dfe596bf101a5

# --- Retrieval ---------------------------------------------------------------
# Reciprocal-rank-fusion constant: a convention from Cormack et al. (2009), not
# a tuned optimum for this corpus, which is why it is configurable and reported
# with every fused response.
CVDE_RRF_K=60
# Ranking horizon. Both rankings are fused once to this depth and paging stops
# there rather than re-ranking a deeper pool per page. Raise it to page further.
CVDE_SEARCH_DEPTH=300
# A query term matching at least this share of images is flagged in the UI as
# too common for BM25 to discriminate on.
CVDE_DF_WARN_FRACTION=0.20

# --- Hubness correction ------------------------------------------------------
# 0 disables the correction entirely and restores the plain cosine ranking.
CVDE_HUBNESS_BETA=0.3
CVDE_HUBNESS_T=0.02
CVDE_HUBNESS_BANK=3000
# 1 builds the ~32 kB penalty artifact on first use; 0 requires an explicit
# `python3 -m app.ml.hubness`.
CVDE_HUBNESS_AUTOBUILD=1

# --- Analysis ----------------------------------------------------------------
# top1-minus-top2 margin below which a zero-shot attribute group abstains
# instead of guessing a label.
CVDE_ATTR_MIN_MARGIN=0.10
# Cosine at or above which two images are reported as near-duplicates.
CVDE_DUP_THRESHOLD=0.95

# --- Optional: Ollama, the assistant, and VLM enrichment ---------------------
CVDE_OLLAMA_URL=http://localhost:11434
# Any Ollama chat model with tool calling.
CVDE_CHAT_MODEL=qwen3:8b
CVDE_VLM_MODEL=qwen2.5vl:7b
# Read-only sample inspection. Only these explicitly installed Ollama aliases
# appear in the UI; an API request never pulls or substitutes a model.
CVDE_VISION_MODELS=gemma4:12b,qwen3.5:9b
CVDE_VISION_DEFAULT_MODEL=gemma4:12b
# Pair comparison is a separately measured capability. It remains disabled if
# this exact digest is not installed under the configured alias.
CVDE_VISION_PAIR_MODEL=qwen3.5:9b
CVDE_VISION_PAIR_MODEL_DIGEST=6488c96fa5faab64bb65cbd30d4289e20e6130ef535a93ef9a49f42eda893ea7
CVDE_VISION_PAIR_RUNTIME_VERSION=0.32.0
CVDE_VISION_STATUS_TIMEOUT=4
CVDE_VISION_TIMEOUT=90
CVDE_VISION_NUM_CTX=8192
CVDE_VISION_NUM_PREDICT=768
# LangGraph-native async node bounds, plus one API-level bound for the complete
# turn. The recursion limit caps the agent's tool-call loop.
CVDE_OLLAMA_TIMEOUT=120
# Context window for the chat model. Pinned so resident memory does not
# depend on which model is configured (an unpinned 30B asked for 44 GB).
CVDE_OLLAMA_NUM_CTX=40960
# Server-side generation cap; cancellation of the HTTP request alone does not
# stop an Ollama decode already in progress.
CVDE_OLLAMA_NUM_PREDICT=1024
CVDE_AGENT_LANE_TIMEOUT=90
CVDE_AGENT_TURN_BUDGET=150
CVDE_AGENT_RECURSION_LIMIT=25

# --- Optional: the autonomous UI QA sweep ------------------------------------
# localhost rather than 127.0.0.1 on purpose: the Vite dev server listens on
# IPv6, so the numeric form connects to nothing.
CVDE_QA_BASE_URL=http://localhost:5173
CVDE_QA_API_URL=http://localhost:8000
# Prefix the QA report puts in front of artifact paths. /api/qa/artifact also
# serves the same files if you would rather not rely on the static mount.
CVDE_QA_URL_PREFIX=/media/qa

# --- Development -------------------------------------------------------------
# Vite proxies /api and /media here during local development. The override is
# useful when testing an isolated backend without disturbing the default port.
CVDE_DEV_API=http://localhost:8000
