# Every environment variable this application reads, with the default it falls
# back to. Nothing here is required -- the defaults are what the README
# documents, and an unset variable is not an error.
#
# Nothing auto-loads this file. backend/app/config.py reads process environment
# variables only, so either export what you need, or hand the file to uvicorn:
#
#   cd backend && uvicorn app.main:app --port 8000 --env-file ../.env
#
# (--env-file needs python-dotenv, which ships with the uvicorn[standard] extra
# already in backend/requirements.txt.)
#
# The batch CLIs -- python -m app.ingest / app.analyze / app.enrich --
# do NOT read it. Export the variables in the shell that runs
# them, and use the same CVDE_EMBED_MODEL you intend to serve with.

# --- Storage -----------------------------------------------------------------
# Images, thumbnails, explorer.db, embeddings, caches, QA artifacts and
# generated reports all live under here. Gitignored; nothing in it is a
# deliverable.
CVDE_DATA_DIR=backend/data

# --- Retrieval provider ------------------------------------------------------
# siglip2 (default — measures better on this corpus's own benchmark) or
# qwen3_vl (opt-in; needs requirements-qwen.txt and its own ingest run).
# Each provider owns its index directory; the qwen manifest pins model and
# prompt version, so a mismatched index refuses to serve rather than ranking
# wrongly.
CVDE_EMBED_PROVIDER=siglip2
CVDE_QWEN_EMBED_MODEL=Qwen/Qwen3-VL-Embedding-2B
CVDE_QWEN_EMBED_BATCH=8

# --- Embedding model (SigLIP) ------------------------------------------------
# WARNING: the vectors on disk and the server that encodes queries have to agree.
# Changing this without re-running ingest and analyze leaves queries encoded in
# one space and images in another. The benchmark cache keys on the artifacts,
# but plain semantic search has no such guard for the flat SigLIP layout — use
# scripts/swap_backbone_so400m.sh to swap properly.
CVDE_EMBED_MODEL=google/siglip2-base-patch16-256
CVDE_EMBED_BATCH=32

# --- Retrieval ---------------------------------------------------------------
# Reciprocal-rank-fusion constant: a convention from Cormack et al. (2009), not
# a tuned optimum for this corpus, which is why it is configurable and reported
# with every fused response.
CVDE_RRF_K=60
# Ranking horizon. Both rankings are fused once to this depth and paging stops
# there rather than re-ranking a deeper pool per page. Raise it to page further.
CVDE_SEARCH_DEPTH=300
# A query term matching at least this share of images is flagged in the UI as
# too common for BM25 to discriminate on.
CVDE_DF_WARN_FRACTION=0.20

# --- Hubness correction ------------------------------------------------------
# 0 disables the correction entirely and restores the plain cosine ranking.
CVDE_HUBNESS_BETA=0.3
CVDE_HUBNESS_T=0.02
CVDE_HUBNESS_BANK=3000
# 1 builds the ~32 kB penalty artifact on first use; 0 requires an explicit
# `python -m app.ml.hubness`.
CVDE_HUBNESS_AUTOBUILD=1

# --- Analysis ----------------------------------------------------------------
# top1-minus-top2 margin below which a zero-shot attribute group abstains
# instead of guessing a label.
CVDE_ATTR_MIN_MARGIN=0.10
# Cosine at or above which two images are reported as near-duplicates.
CVDE_DUP_THRESHOLD=0.95

# --- Optional: Ollama, the assistant, and VLM enrichment ---------------------
CVDE_OLLAMA_URL=http://localhost:11434
# Any Ollama chat model with tool calling.
CVDE_CHAT_MODEL=qwen3:8b
CVDE_VLM_MODEL=qwen2.5vl:7b
# Three nested bounds so one stalled local model call cannot hold an HTTP
# request open: seconds per model call, seconds per specialist lane, and tool
# steps inside a lane.
CVDE_OLLAMA_TIMEOUT=120
# Context window for the chat model. Pinned so resident memory does not
# depend on which model is configured (an unpinned 30B asked for 44 GB).
CVDE_OLLAMA_NUM_CTX=40960
CVDE_AGENT_LANE_TIMEOUT=240
CVDE_AGENT_RECURSION_LIMIT=25

# --- Optional: the autonomous UI QA sweep ------------------------------------
# localhost rather than 127.0.0.1 on purpose: the Vite dev server listens on
# IPv6, so the numeric form connects to nothing.
CVDE_QA_BASE_URL=http://localhost:5173
CVDE_QA_API_URL=http://localhost:8000
# Prefix the QA report puts in front of artifact paths. /api/qa/artifact also
# serves the same files if you would rather not rely on the static mount.
CVDE_QA_URL_PREFIX=/media/qa
